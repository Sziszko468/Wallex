# Usually you do NOT need to set this: the app auto-detects your dev
# machine's LAN IP from Expo's own dev-server connection info, which works
# for Expo Go on a physical phone and for the iOS simulator.
#
# Uncomment ONE of these if auto-detection doesn't reach your backend:
#
# Android emulator (localhost inside the emulator is the emulator itself,
# not your dev machine — 10.0.2.2 is the special alias back to the host):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api
#
# iOS simulator (shares the host's network, so plain localhost works):
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
#
# Physical device, if auto-detection picks the wrong network interface:
# EXPO_PUBLIC_API_BASE_URL=http://<your-computer-LAN-IP>:8000/api
