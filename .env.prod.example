# Spendly — production configuration for docker-compose.prod.yml
#
#   cp .env.prod.example .env.prod      (.env.prod is gitignored — never commit it)
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Every variable is documented in docs/deployment.md. Commented-out lines are optional
# and show the default. Keep comments on their own lines (not after a value).

# === Django (required) =================================================================
# 50+ random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# Public host name(s) of the site, comma-separated. Never "*".
DJANGO_ALLOWED_HOSTS=spendly.example.com

# === HTTPS / proxies ===================================================================
# The web container must sit behind a TLS-terminating proxy or load balancer that sets
# X-Forwarded-Proto. For a local trial over plain http://localhost set
# DJANGO_SECURE_SSL_REDIRECT=False (and DJANGO_ALLOWED_HOSTS=localhost).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_BEHIND_TLS_PROXY=True
# Proxies between the client and Django: 1 = the web container's nginx.
# Add one for every load balancer / proxy in front of it (rate limiting uses the client IP).
DRF_NUM_PROXIES=1

# === Database (required) ===============================================================
# Used by the postgres container AND by Django.
POSTGRES_DB=spendly
POSTGRES_USER=spendly
# Long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer
# A managed database instead of the postgres container: one URL overrides POSTGRES_*.
# DATABASE_URL=postgres://user:password@db.example.com:5432/spendly?sslmode=require
# DJANGO_DB_CONN_MAX_AGE=60

# === CORS / CSRF =======================================================================
# Not needed when the web app is served by this stack (same origin). Only for a web
# front end hosted on another domain; https:// origins only.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://spendly.example.com

# === Optional tuning ===================================================================
# Separate JWT key (rotating it signs everyone out). If set, 50+ random characters.
# JWT_SIGNING_KEY=
# Shared cache for rate limiting (default: a table in PostgreSQL).
# CACHE_URL=dbcache://spendly_cache
# DJANGO_LOG_LEVEL=INFO
# gunicorn worker processes (~100 MB RAM each) and request timeout in seconds.
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=60
# API_USER_RATE=2000/hour
# AUTH_LOGIN_RATE=10/minute
# AUTH_REGISTER_RATE=10/hour
# AUTH_REFRESH_RATE=30/minute
# RECEIPT_SCAN_RATE=30/hour
# RECEIPT_OCR_LANGUAGES=hun+eng
# Only if "Enhanced push security" is enabled in the Expo dashboard.
# EXPO_PUSH_ACCESS_TOKEN=
# Public Swagger UI (/api/docs/) and OpenAPI schema (/api/schema/). Off by default in production.
# API_DOCS_ENABLED=False

# === Web image / compose ===============================================================
# Baked into the web bundle at build time. /api = same origin through the web container.
VITE_API_BASE_URL=/api
# Host port the web container is published on.
WEB_PORT=8080
# Tag for the built images (e.g. a git commit SHA when pushing to a registry).
# SPENDLY_IMAGE_TAG=latest
