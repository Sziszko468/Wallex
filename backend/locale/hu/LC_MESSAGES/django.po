#: apps/receipts/services.py:50
msgid "Please upload a JPEG or PNG photo."
msgstr "Kérjük, JPEG vagy PNG fotót tölts fel."

#: apps/receipts/services.py:52
msgid "The photo's resolution is too high."
msgstr "A fotó felbontása túl nagy."

#: apps/receipts/services.py:55
msgid "The file is not a readable image."
msgstr "A fájl nem olvasható kép."

#: apps/receipts/services.py:71
msgid "The photo could not be processed. Please try another one."
msgstr "A fotót nem sikerült feldolgozni. Kérjük, próbálj meg egy másikat."

#: apps/receipts/views.py:45 apps/transactions/views.py:106
#: apps/users/views.py:178
msgid "This field is required."
msgstr "Ez a mező kötelező."

#: apps/receipts/views.py:54
msgid "Receipt scanning is temporarily unavailable. Please add the transaction manually."
msgstr "A blokk beolvasása átmenetileg nem érhető el. Kérjük, add hozzá kézzel a tranzakciót."

#: apps/subscriptions/serializers.py:98
msgid "Subscriptions are expenses: choose an expense category."
msgstr "Az előfizetések kiadások: válassz kiadási kategóriát."

#: apps/transactions/models.py:75 apps/transactions/serializers.py:87
msgid "Transaction type must match the selected category's type."
msgstr "A tranzakció típusának egyeznie kell a kiválasztott kategória típusával."

#: apps/transactions/models.py:138 apps/transactions/serializers.py:215
msgid "Recurring transaction type must match the selected category's type."
msgstr "Az ismétlődő tranzakció típusának egyeznie kell a kiválasztott kategória típusával."

#: apps/transactions/models.py:141 apps/transactions/serializers.py:218
msgid "Subscriptions are always expenses."
msgstr "Az előfizetések mindig kiadások."

#: apps/transactions/serializers.py:108
msgid "Must be 1 when the currency is your base currency."
msgstr "1-nek kell lennie, ha a pénznem az alap pénznemed."

#: apps/transactions/serializers.py:117
#, python-format
msgid "%(error)s Enter the rate manually or try again later."
msgstr "%(error)s Add meg az árfolyamot kézzel, vagy próbáld újra később."

#: apps/transactions/serializers.py:122
msgid "This amount is too large to convert to your base currency."
msgstr "Ez az összeg túl nagy ahhoz, hogy átváltható legyen az alap pénznemedre."

#: apps/transactions/serializers.py:142
msgid "End date must be on or after the start date."
msgstr "A befejező dátum nem lehet a kezdő dátum előtt."

#: apps/transactions/services.py:68
#, python-format
msgid "This file is not valid CSV (%(error)s)."
msgstr "Ez a fájl nem érvényes CSV (%(error)s)."

#: apps/transactions/services.py:74
msgid "The uploaded file is empty."
msgstr "A feltöltött fájl üres."

#: apps/transactions/services.py:76
msgid "This doesn't look like a CSV file (it contains binary data)."
msgstr "Ez nem tűnik CSV-fájlnak (bináris adatot tartalmaz)."

#: apps/transactions/services.py:82
msgid "Could not read this file as text (unsupported encoding)."
msgstr "A fájlt nem sikerült szövegként beolvasni (nem támogatott kódolás)."

#: apps/transactions/services.py:93
#, python-format
msgid "Unrecognized date '%(value)s' (expected YYYY-MM-DD or DD/MM/YYYY)."
msgstr "Ismeretlen dátum: „%(value)s” (várható: ÉÉÉÉ-HH-NN vagy NN/HH/ÉÉÉÉ)."

#: apps/transactions/services.py:102
msgid "Amount is empty."
msgstr "Az összeg üres."

#: apps/transactions/services.py:106
#, python-format
msgid "Unrecognized amount '%(value)s'."
msgstr "Ismeretlen összeg: „%(value)s”."

#: apps/transactions/services.py:108
msgid "Amount cannot be zero."
msgstr "Az összeg nem lehet nulla."

#: apps/transactions/services.py:124
msgid "Could not read this file as CSV."
msgstr "A fájlt nem sikerült CSV-ként beolvasni."

#: apps/transactions/services.py:130
#, python-format
msgid "Missing required column(s): %(columns)s."
msgstr "Hiányzó kötelező oszlop(ok): %(columns)s."

#: apps/transactions/services.py:155
#, python-format
msgid "Too many rows — at most %(max_rows)s per import."
