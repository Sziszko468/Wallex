#: apps/analytics/achievement_texts.py:12
msgid "First Transaction"
msgstr "Első tranzakció"

#: apps/analytics/achievement_texts.py:13
msgid "Record your first transaction."
msgstr "Rögzítsd az első tranzakciódat."

#: apps/analytics/achievement_texts.py:14
msgid "7 Day Tracking Streak"
msgstr "7 napos követési sorozat"

#: apps/analytics/achievement_texts.py:15
msgid "Record transactions on 7 days in a row."
msgstr "Rögzíts tranzakciókat 7 egymást követő napon."

#: apps/analytics/achievement_texts.py:16
msgid "30 Day Tracking Streak"
msgstr "30 napos követési sorozat"

#: apps/analytics/achievement_texts.py:17
msgid "Record transactions on 30 days in a row."
msgstr "Rögzíts tranzakciókat 30 egymást követő napon."

#: apps/analytics/achievement_texts.py:18
msgid "First €100 Saved"
msgstr "Az első 100 € megtakarítva"

#: apps/analytics/achievement_texts.py:19
msgid "Have €100 in your savings goals."
msgstr "Legyen 100 € a megtakarítási céljaidban."

#: apps/analytics/achievement_texts.py:20
msgid "€1,000 Saved"
msgstr "1 000 € megtakarítva"

#: apps/analytics/achievement_texts.py:21
msgid "Have €1,000 in your savings goals."
msgstr "Legyen 1 000 € a megtakarítási céljaidban."

#: apps/analytics/achievement_texts.py:22
msgid "Completed Savings Goal"
msgstr "Teljesített megtakarítási cél"

#: apps/analytics/achievement_texts.py:23
msgid "Reach the target of a savings goal."
msgstr "Érd el egy megtakarítási cél célösszegét."

#: apps/analytics/achievement_texts.py:24
msgid "Stayed Under Budget"
msgstr "Költségkereten belül maradtál"

#: apps/analytics/achievement_texts.py:25
msgid "Finish a month without going over a budget."
msgstr "Zárj le egy hónapot úgy, hogy nem lépsz túl egy költségkeretet sem."

#: apps/analytics/achievements.py:246
#, python-format
msgid "Stayed Under %(category)s Budget"
msgstr "%(category)s költségkeret betartva"

#: apps/analytics/assistant/client.py:26
msgid "The assistant is temporarily unavailable. Please try again in a moment."
msgstr "Az asszisztens átmenetileg nem érhető el. Kérjük, próbáld újra egy pillanat múlva."

#: apps/analytics/assistant/client.py:27
msgid "The assistant is busy right now. Please try again in a minute."
msgstr "Az asszisztens most elfoglalt. Kérjük, próbáld újra egy perc múlva."

#: apps/analytics/assistant/engine.py:23
msgid "Sorry, I can't help with that. I can answer questions about your spending, budgets, subscriptions and savings goals in WALLEX."
msgstr "Sajnos ebben nem tudok segíteni. A WALLEX-ben a kiadásaidról, költségkereteidről, előfizetéseidről és megtakarítási céljaidról tudok válaszolni."

#: apps/analytics/assistant/engine.py:26
msgid "The assistant couldn't finish this answer. Please try again."
msgstr "Az asszisztens nem tudta befejezni ezt a választ. Kérjük, próbáld újra."

#: apps/analytics/assistant/engine.py:27
msgid "The answer took too long. Please try again."
msgstr "A válasz túl sokáig tartott. Kérjük, próbáld újra."

#: apps/analytics/assistant/prompts.py:18
msgid "There isn't enough data available."
msgstr "Nem áll rendelkezésre elegendő adat."

#: apps/analytics/assistant/suggestions.py:22
msgid "What did I spend the most on this month?"
msgstr "Mire költöttem a legtöbbet ebben a hónapban?"

#: apps/analytics/assistant/suggestions.py:23
msgid "Where did I spend more than last month?"
msgstr "Mire költöttem többet, mint előző hónapban?"

#: apps/analytics/assistant/suggestions.py:24
msgid "Which of my subscriptions costs the most?"
msgstr "Melyik előfizetésem kerül a legtöbbe?"

#: apps/analytics/assistant/suggestions.py:25
msgid "Am I staying within my budgets this month?"
msgstr "Tartom a költségkereteimet ebben a hónapban?"

#: apps/analytics/assistant/suggestions.py:41
msgid "Why did my spending change compared to last month?"
msgstr "Miért változtak a kiadásaim az előző hónaphoz képest?"

#: apps/analytics/assistant/suggestions.py:43
#, python-format
msgid "How much did I spend on %(category)s this month?"
msgstr "Mennyit költöttem ebben a hónapban erre: %(category)s?"

#: apps/analytics/assistant/suggestions.py:48
#, python-format
msgid "How am I doing with my %(goal)s savings goal?"
msgstr "Hogy állok a(z) %(goal)s megtakarítási céllal?"

#: apps/analytics/assistant/tools.py:480
msgid "Monthly spending"
msgstr "Havi kiadások"

#: apps/analytics/assistant/tools.py:493
msgid "Spending by category"
msgstr "Kiadások kategóriánként"

#: apps/analytics/assistant/tools.py:510
msgid "Spending by merchant"
msgstr "Kiadások kereskedőnként"

#: apps/analytics/assistant/tools.py:526
msgid "Budgets"
msgstr "Költségkeretek"

#: apps/analytics/assistant/tools.py:540
msgid "Subscriptions"
msgstr "Előfizetések"

#: apps/analytics/assistant/tools.py:554
msgid "Savings goals"
msgstr "Megtakarítási célok"

#: apps/analytics/assistant/tools.py:573
msgid "Month comparison"
msgstr "Hónapok összehasonlítása"

#: apps/analytics/assistant/tools.py:644
#, python-format
msgid "%(period)s vs %(compared)s"
msgstr "%(period)s és %(compared)s"

#: apps/analytics/assistant/views.py:20
msgid "The AI assistant isn't set up on this server."
msgstr "Az AI asszisztens még nincs beállítva ezen a szerveren."

#: apps/analytics/assistant/views.py:95
msgid "This conversation is full. Start a new conversation to ask more."
msgstr "Ez a beszélgetés megtelt. Indíts egy újat, ha további kérdéseket szeretnél feltenni."

#: apps/analytics/insights.py:135
#, python-format
msgid "Highest spending category is %(name)s (%(percent)s%% of this month's expenses)."
msgstr "A legnagyobb kiadási kategória: %(name)s (az e havi kiadások %(percent)s%%-a)."

#: apps/analytics/insights.py:189
#, python-format
msgid "Total spending exceeded the overall monthly budget by %(percent)s%%."
msgstr "Az összes kiadás %(percent)s%%-kal meghaladta az összesített havi költségkeretet."

#: apps/analytics/insights.py:191
#, python-format
msgid "%(name)s exceeded its budget by %(percent)s%%."
msgstr "A(z) %(name)s kiadás %(percent)s%%-kal meghaladta a költségkeretét."

#: apps/analytics/insights.py:207
#, python-format
msgid "You have used %(percent)s%% of your overall budget."
msgstr "Az összesített költségkereted %(percent)s%%-át felhasználtad."

#: apps/analytics/insights.py:209
#, python-format
msgid "You have used %(percent)s%% of the %(name)s budget."
msgstr "A(z) %(name)s költségkeret %(percent)s%%-át felhasználtad."

#: apps/analytics/insights.py:235
#, python-format
msgid "Recurring expenses represent %(percent)s%% of income."
msgstr "Az ismétlődő kiadások a bevétel %(percent)s%%-át teszik ki."

#: apps/analytics/insights.py:255
#, python-format
msgid "Expenses exceeded income by %(percent)s%% this month."
msgstr "Ebben a hónapban a kiadások %(percent)s%%-kal meghaladták a bevételt."

#: apps/analytics/insights.py:267
#, python-format
msgid "You saved %(percent)s%% of your income this month."
msgstr "Ebben a hónapban a bevételed %(percent)s%%-át megtakarítottad."

#: apps/analytics/insights.py:277
#, python-format
msgid "%(name)s spending increased by %(percent)s%% compared to the same period last month."
msgstr "A(z) %(name)s kiadások %(percent)s%%-kal nőttek az előző hónap azonos időszakához képest."

#: apps/analytics/insights.py:278
#, python-format
msgid "%(name)s spending increased by %(percent)s%% compared to last month."
msgstr "A(z) %(name)s kiadások %(percent)s%%-kal nőttek az előző hónaphoz képest."

#: apps/analytics/insights.py:279
#, python-format
msgid "%(name)s spending decreased by %(percent)s%% compared to the same period last month."
msgstr "A(z) %(name)s kiadások %(percent)s%%-kal csökkentek az előző hónap azonos időszakához képest."

#: apps/analytics/insights.py:280
#, python-format
msgid "%(name)s spending decreased by %(percent)s%% compared to last month."
msgstr "A(z) %(name)s kiadások %(percent)s%%-kal csökkentek az előző hónaphoz képest."

#: apps/budgets/savings.py:122
msgid "This goal is archived. Restore it to add or remove money."
msgstr "Ez a cél archiválva van. Állítsd vissza, hogy pénzt adhass hozzá vagy vonhass le belőle."

#: apps/budgets/savings.py:125
#, python-format
msgid "You can't remove more than the %(amount)s %(currency)s saved."
msgstr "Legfeljebb a megtakarított összeget (%(amount)s %(currency)s) vonhatod le."

#: apps/budgets/savings.py:131
msgid "This would make the saved amount too large."
msgstr "Ettől a megtakarított összeg túl nagy lenne."

#: apps/budgets/serializers.py:76
msgid "Budgets can only be set for expense categories."
msgstr "Költségkeret csak kiadási kategóriákhoz állítható be."

#: apps/budgets/serializers.py:85
msgid "A budget for this category and month already exists."
msgstr "Ehhez a kategóriához és hónaphoz már van költségkeret."

#: apps/budgets/serializers.py:174
msgid "A goal is completed automatically when the saved amount reaches the target."
msgstr "A cél automatikusan teljesül, amint a megtakarított összeg eléri a célösszeget."

#: apps/budgets/serializers.py:181
msgid "The target date can't be in the past."
msgstr "A céldátum nem lehet a múltban."

#: apps/budgets/serializers.py:191
msgid "The currency can't change once money is saved in the goal."
msgstr "A pénznem nem módosítható, ha már van megtakarított pénz a célban."

#: apps/budgets/serializers.py:196 apps/budgets/serializers.py:233
#: apps/currencies/serializers.py:14 apps/transactions/services.py:184
#, python-format
msgid "%(currency)s amounts can't have decimals."
msgstr "%(currency)s összegben nem lehetnek tizedesjegyek."

