DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
# "*" accepts any Host header — fine for local dev (LAN-connected phones/emulators
# hit this over a raw IP), tighten to explicit hostnames before deploying anywhere.
DJANGO_ALLOWED_HOSTS=*
# 5173 = web app (Vite); 8081 = mobile app's Expo web-preview target
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

POSTGRES_DB=wallex
POSTGRES_USER=wallex_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Alternative to the POSTGRES_* values (managed databases hand out one URL):
# DATABASE_URL=postgres://user:password@host:5432/wallex?sslmode=require

# Production uses the root .env.prod.example + docker-compose.prod.yml instead of this
# file — see docs/deployment.md.

# Push notifications (Expo). Leave empty unless "Enhanced push security" is
# enabled in the Expo dashboard — then paste an access token from expo.dev.
EXPO_PUSH_ACCESS_TOKEN=

# Receipt scanning (optional overrides). Provider = dotted path of an OcrProvider class.
# RECEIPT_OCR_PROVIDER=apps.receipts.ocr.tesseract.TesseractOcrProvider
# RECEIPT_OCR_LANGUAGES=hun+eng
# RECEIPT_SCAN_RATE=30/hour

# AI finance assistant (docs/ai-assistant.md). The API key stays on the server: never put it in
# web/.env, mobile/.env or any VITE_* / EXPO_PUBLIC_* variable. Off while the key is empty.
# Gemini (default): get a key at https://aistudio.google.com/apikey. The FREE tier lets Google use
# what you send to improve its products, so use test data only; real users need a paid plan.
GEMINI_API_KEY=
# Claude instead (optional): get a key at platform.claude.com and set AI_ASSISTANT_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# AI_ASSISTANT_PROVIDER=gemini
# AI_ASSISTANT_MODEL=gemini-3.8-flash
# AI_ASSISTANT_EFFORT=low
# AI_ASSISTANT_MAX_TOKENS=16000
# AI_ASSISTANT_TIMEOUT=90
# AI_ASSISTANT_RATE=30/hour
# AI_ASSISTANT_MAX_QUESTION_LENGTH=1000
# AI_ASSISTANT_HISTORY_MESSAGES=20
# AI_ASSISTANT_MAX_MESSAGES=50

# --- Security (production) -------------------------------------------------------------
# config/settings/prod.py refuses to start with ALLOWED_HOSTS "*", a short/placeholder
# DJANGO_SECRET_KEY, or non-https CORS origins. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Optional separate JWT key (rotating it signs everyone out without touching SECRET_KEY):
# JWT_SIGNING_KEY=
# Encrypts two-factor secrets (defaults to DJANGO_SECRET_KEY in development; production
# requires its own 50+ character value):
# FIELD_ENCRYPTION_KEY=
# The web app's refresh-token cookie is Secure in production; plain-http dev keeps it off:
# AUTH_COOKIE_SECURE=False
# Number of reverse proxies in front of Django (for client-IP rate limiting). 0 = none.
# DRF_NUM_PROXIES=0
# Set when a TLS-terminating proxy ALWAYS sends X-Forwarded-Proto:
# DJANGO_BEHIND_TLS_PROXY=False
# Origins allowed to POST to the Django admin (https://api.example.com):
# CSRF_TRUSTED_ORIGINS=
# Rate limits (DRF format "N/second|minute|hour|day"):
# AUTH_LOGIN_RATE=10/minute
# AUTH_REGISTER_RATE=10/hour
# AUTH_REFRESH_RATE=30/minute
# API_USER_RATE=2000/hour
