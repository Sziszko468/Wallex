# Local development (npm run dev): the Django API on its own port.
VITE_API_BASE_URL=http://localhost:8000/api

# Production builds get the value at build time instead (see docs/deployment.md):
#   /api                          web image — nginx proxies it to the backend (same origin, default)
#   https://api.example.com/api   static hosting with the API on another domain (needs CORS)
